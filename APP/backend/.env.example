# ---------------------------------------------------------------------------
# Generic starter environment. Copy to .env and fill in.
# Startup FAILS FAST (src/config/env.ts) if a required var is missing/invalid.
# NEVER commit real secrets, domains, emails, or phone numbers.
# ---------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/haidara?schema=public

# --- Auth: separate secrets per token type, min 32 chars each ---
JWT_ACCESS_SECRET=replace-with-strong-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-strong-random-refresh-secret-min-32-chars
COOKIE_SECRET=replace-with-strong-random-cookie-secret-min-32-chars

# Short-lived access token, longer-lived rotating refresh token (seconds).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Lifetimes for setup / reset tokens (seconds).
ACCOUNT_SETUP_TOKEN_TTL=86400
PASSWORD_RESET_TOKEN_TTL=3600

# --- CORS: comma-separated allow-list. Do NOT use "*" in production. ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# App base URL used to build setup/reset links in emails.
FRONTEND_URL=http://localhost:5173

# --- Distribution scheduler (in-process background flow) ---
# ON by default: the API process drives scheduled-campaign activation, due
# call-center automation, complaint SLAs and scheduled
# reports on this interval — no separate worker process needed. Set to false
# ONLY on API replicas where a dedicated background worker runs instead.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_MS=30000

# --- Rate limiting (per-instance, in-memory) ---
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW=60000
# Stricter limits for sensitive auth endpoints.
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=60000

# --- Files ---
FILE_STORAGE_DIR=./uploads
MAX_UPLOAD_SIZE=5242880
ALLOWED_UPLOAD_MIME=image/png,image/jpeg,application/pdf

# --- Email (capability-gated; off by default so seeds/tests never send mail) ---
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# NON-PRODUCTION recipient allowlist (CSV). Strongly recommended whenever
# EMAIL_ENABLED=true with REAL SMTP credentials on a dev/test machine: recipient
# addresses come from the database, so a worker cycle, an integration test run
# (RUN_INTEGRATION=true) or a one-off script can otherwise mail a real customer.
# When set, an email to any other address is SKIPPED before the SMTP transport is
# touched and recorded honestly (never a fake SENT / providerMessageId).
# Entries are a full address or a whole domain. Ignored in production, and
# ignored when empty (leaving it blank preserves the previous behaviour).
# Example: EMAIL_RECIPIENT_ALLOWLIST=@example.test,qa@example.test
EMAIL_RECIPIENT_ALLOWLIST=

# --- Development seed admin (env-gated; NO hardcoded credentials) ---
SEED_DEV_ADMIN=true
DEV_ADMIN_EMAIL=admin@diamond.test
DEV_ADMIN_PASSWORD=Diamond123!

# Dedicated AES-256-GCM key for TOTP secrets at rest (min 32 chars).
TWO_FACTOR_ENCRYPTION_KEY=replace-with-strong-random-two-factor-key-min-32-chars
TWO_FACTOR_CHALLENGE_TTL=300
TWO_FACTOR_SETUP_TTL=600
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_RECOVERY_CODE_COUNT=10
