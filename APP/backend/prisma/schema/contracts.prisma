// ---------------------------------------------------------------------------
// Diamond rental contracts. Contract is the single rental aggregate — there is
// no parallel Rental model. Vehicle.operationalStatus is synchronized from
// this domain (RENTED at Car-Out, AVAILABLE at Car-In). Close does not release
// the vehicle.
// ---------------------------------------------------------------------------

enum ContractStatus {
  AWAITING
  FORM
  SIGNED
  PAID
  ACTIVE
  RETOUT
  REVIEW
  CLOSED
}

enum ContractPriceType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ContractLinkType {
  RENTAL
  RETURN
  RENEWAL
}

enum ContractPaymentMethod {
  BANK_TRANSFER
  CARD
  MANUAL
}

enum ContractPaymentStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  CANCELLED
}

enum ContractPaymentPurpose {
  RENTAL
  RENEWAL
  RECONCILIATION
  POST_CLOSE_RECEIVABLE
}

enum ContractDocumentType {
  DRIVING_LICENSE
  PASSPORT
}

/// Signature boxes on the official contract paper.
enum OfficialContractSignatureSlot {
  HIRER
  ADDITIONAL_DRIVER
  SPONSOR
  VEHICLE_OUT_HIRER
  VEHICLE_IN_HIRER
}

/// Provider-neutral passport OCR state. Vendor-specific states are never stored.
enum PassportExtractionStatus {
  PROCESSING
  READY
  NOT_RECOGNIZED
  FAILED
  PROVIDER_UNAVAILABLE
}

enum DrivingLicenseVerificationStatus {
  PENDING
  VALID
  EXPIRED
  UNREADABLE
  REVIEW_REQUIRED
  PROVIDER_UNAVAILABLE
}

enum CustomerDocumentType {
  IDENTITY
  PASSPORT
  DRIVING_LICENSE
}

enum ContractReconciliationLineType {
  DAMAGE
  FUEL
  LATE
  SALIK
  VIOLATION
  OTHER
}

/// Demo 8-angle inspection set (Car-Out / Car-In). Evidence, not VehiclePhoto.
enum ContractInspectionAngle {
  FRONT
  REAR
  RIGHT_SIDE
  LEFT_SIDE
  FRONT_PLATE
  REAR_PLATE
  INTERIOR_ODOMETER
  TIRES
  LEFT
  RIGHT
  FRONT_LEFT
  FRONT_RIGHT
  REAR_LEFT
  REAR_RIGHT
  ODOMETER
  DASHBOARD_FUEL
  OTHER
}

/// Year-scoped monotonic allocator for DE-{year}-{nnnnnn}. Locked in-process
/// via advisory lock `contract_number` + year — never derived from row count.
model ContractNumberSequence {
  year      Int @id
  lastValue Int @default(0)

  @@map("contract_number_sequences")
}

model Contract {
  id                     String         @id @default(uuid())
  contractNumber         String         @unique
  status                 ContractStatus @default(AWAITING)
  vehicleId              Int
  vehicle                Vehicle        @relation(fields: [vehicleId], references: [id])
  customerId             Int?
  customer               Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdByUserId        Int
  createdBy              User           @relation("ContractCreatedBy", fields: [createdByUserId], references: [id])
  assignedEmployeeUserId Int?
  assignedEmployee       User?          @relation("ContractAssignedEmployee", fields: [assignedEmployeeUserId], references: [id], onDelete: SetNull)

  priceType     ContractPriceType
  rentalDays    Int
  /// Contractual amount in whole AED. Vehicle dailyRate/monthlyRate are defaults only.
  agreedAmount  Int
  currency      String            @default("AED")
  startAt       DateTime?
  endAt         DateTime?
  /// Legacy column — Diamond V1 does not use rental deposits. Kept for non-destructive migration.
  depositAmount Int?

  /// Frozen legal facts. Written no later than SIGNED; never rewritten after that.
  snapshot Json?

  termsVersion String @default("diamond-rental-terms-v1")

  activatedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  revision    Int       @default(0)

  links                ContractLink[]
  acceptance           ContractAcceptance?
  payments             ContractPayment[]
  cardPaymentMethod    ContractCardPaymentMethod?
  documents            ContractDocument[]
  licenseVerifications DrivingLicenseVerification[]
  passportExtractions  PassportExtraction[]
  officialReviewDraft  OfficialContractReviewDraft?
  officialSignatures   OfficialContractSignature[]
  carOut               ContractCarOut?
  carOutDraft          ContractCarOutDraft?
  carIn                ContractCarIn?
  reconciliation       ContractReconciliation?
  renewals             ContractRenewal[]
  /// TARS integration metadata only. Contract lifecycle never depends on it.
  tarsIntegration      TarsContractIntegration?
  tarsOperations       TarsOperation[]
  roadLiabilities      RoadLiability[]
  customerCharges      RoadLiabilityCustomerCharge[]
  postCloseReceivables ContractPostCloseReceivable[]

  @@index([vehicleId, status])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("contracts")
}

model ContractCardPaymentMethod {
  id                    String   @id @default(uuid())
  contractId            String   @unique
  contract              Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  provider              String   @default("stripe")
  stripeCustomerId      String?
  /// Null for the explicit DEV_SIMULATION source; real Stripe ids are never faked.
  stripePaymentMethodId String?  @unique
  cardBrand             String
  cardLast4             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("contract_card_payment_methods")
}

model ContractLink {
  id              String           @id @default(uuid())
  contractId      String
  contract        Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type            ContractLinkType
  /// SHA-256 hex of the opaque token. Raw token is returned once and never persisted.
  tokenHash       String           @unique
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  createdByUserId Int?
  createdBy       User?            @relation("ContractLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([contractId, type])
  @@index([expiresAt])
  @@map("contract_links")
}

model ContractAcceptance {
  id                    String      @id @default(uuid())
  contractId            String      @unique
  contract              Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  acceptedAt            DateTime
  ip                    String?
  userAgent             String?
  termsVersion          String
  signatureAttachmentId String?
  signatureAttachment   Attachment? @relation("ContractSignatureAttachment", fields: [signatureAttachmentId], references: [id], onDelete: SetNull)
  createdAt             DateTime    @default(now())

  @@map("contract_acceptances")
}

model ContractPayment {
  id                   String                 @id @default(uuid())
  contractId           String
  contract             Contract               @relation(fields: [contractId], references: [id], onDelete: Cascade)
  purpose              ContractPaymentPurpose @default(RENTAL)
  /// Obligation target: contractId (RENTAL), renewalId, reconciliationId, or receivableId.
  targetId             String
  amount               Int
  currency             String                 @default("AED")
  method               ContractPaymentMethod
  status               ContractPaymentStatus  @default(PENDING)
  externalReference    String?
  provider             String?
  providerReference    String?
  providerStatus       String?
  checkoutUrl          String?
  checkoutExpiresAt    DateTime?
  processingStartedAt  DateTime?
  confirmedAt          DateTime?
  failedAt             DateTime?
  /// SHA-256 of the one-time payment-status token. Raw value is never stored.
  statusTokenHash      String?                @unique
  statusTokenExpiresAt DateTime?
  createdAt            DateTime               @default(now())
  createdByUserId      Int?
  createdBy            User?                  @relation("ContractPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  reconciliationSettlement ContractReconciliation?      @relation("ReconciliationSettlement")
  postCloseSettlement      ContractPostCloseReceivable? @relation("PostCloseSettlement")
  renewalSettlement        ContractRenewal?             @relation("RenewalSettlement")
  ledgerEntries            FinancialLedgerEntry[]

  @@index([contractId, status])
  @@index([purpose, targetId, status])
  @@map("contract_payments")
}

/// DB-backed Stripe webhook idempotency. Same event must not apply business effects twice.
model StripeWebhookEvent {
  id            String    @id @default(uuid())
  stripeEventId String    @unique
  eventType     String
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  outcome       String?
  error         String?

  @@index([receivedAt])
  @@map("stripe_webhook_events")
}

/// Contract-scoped file (customer may not exist yet). One active driving license
/// per contract for the public rental verification flow (`supersededAt` null).
model ContractDocument {
  id           String               @id @default(uuid())
  contractId   String
  contract     Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type         ContractDocumentType
  attachmentId String
  attachment   Attachment           @relation("ContractDocumentAttachment", fields: [attachmentId], references: [id], onDelete: Restrict)
  supersededAt DateTime?
  createdAt    DateTime             @default(now())

  verifications       DrivingLicenseVerification[]
  passportExtractions PassportExtraction[]

  @@index([contractId, type, supersededAt])
  @@map("contract_documents")
}

model DrivingLicenseVerification {
  id              String                           @id @default(uuid())
  contractId      String
  contract        Contract                         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  documentId      String
  document        ContractDocument                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  attachmentId    String
  status          DrivingLicenseVerificationStatus @default(PENDING)
  licenseNumber   String?
  /// Calendar date stored at UTC noon so timezone offsets cannot shift the day.
  expiryDate      DateTime?
  confidence      Float?
  provider        String?
  providerVersion String?
  verifiedAt      DateTime?
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt

  @@index([contractId, createdAt])
  @@map("driving_license_verifications")
}

/// Normalized passport OCR result for one PASSPORT ContractDocument attempt.
/// Only normalized fields are stored — no raw provider payload, no image bytes.
/// The attempt whose document is not superseded is authoritative.
model PassportExtraction {
  id                 String                   @id @default(uuid())
  contractId         String
  contract           Contract                 @relation(fields: [contractId], references: [id], onDelete: Cascade)
  documentId         String                   @unique
  document           ContractDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  attachmentId       String
  status             PassportExtractionStatus @default(PROCESSING)
  fullName           String?
  firstName          String?
  middleName         String?
  lastName           String?
  nationality        String?
  passportNumber     String?
  /// Calendar dates stored at UTC noon.
  passportIssueDate  DateTime?
  passportExpiryDate DateTime?
  dateOfBirth        DateTime?
  sex                String?
  issuingCountry     String?
  confidence         Float?
  provider           String?
  providerVersion    String?
  completedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([contractId, createdAt])
  @@map("passport_extractions")
}

/// Customer review overrides for the official contract's personal fields only.
/// A non-null column overrides the normalized OCR/record value; OCR rows are never mutated.
/// Never holds vehicle, pricing, days, Car-Out/Car-In, deposit or payment-card data.
model OfficialContractReviewDraft {
  id                            String    @id @default(uuid())
  contractId                    String    @unique
  contract                      Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  hirerName                     String?
  nationality                   String?
  passportNumber                String?
  address                       String?
  telephone                     String?
  additionalDriverName          String?
  additionalDriverNationality   String?
  additionalDriverLicenseNumber String?
  sponsorName                   String?
  sponsorIdNumber               String?
  /// Last 4 digits only. The full card number is never sent to or stored by Diamond.
  cardNumberLast4               String?
  /// Structured damage marks: [{ zone, type }]. OUT is customer-marked before signing; IN is staff (return).
  damageOut                     Json?
  damageIn                      Json?
  /// Staff-set official-contract terms (no other Diamond source exists). Read-only to the customer.
  plateCode                     String?
  contractNotes                 String?
  includedKmPerDay              Int?
  extraKmRate                   Decimal?  @db.Decimal(10, 2)
  reviewedAt                    DateTime?
  revision                      Int       @default(0)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  @@map("official_contract_review_drafts")
}

/// One captured signature image per official-contract slot (latest capture wins).
model OfficialContractSignature {
  id           String                        @id @default(uuid())
  contractId   String
  contract     Contract                      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  slot         OfficialContractSignatureSlot
  attachmentId String
  attachment   Attachment                    @relation("OfficialContractSignatureAttachment", fields: [attachmentId], references: [id], onDelete: Restrict)
  capturedAt   DateTime
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  @@unique([contractId, slot])
  @@map("official_contract_signatures")
}

model ContractCarOut {
  id                String   @id @default(uuid())
  contractId        String   @unique
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  performedByUserId Int
  performedBy       User     @relation("ContractCarOutPerformedBy", fields: [performedByUserId], references: [id])
  occurredAt        DateTime
  mileageOut        Int
  fuelOut           String
  notes             String?
  vehicleId         Int?
  damageOut         Json?
  hirerSignatureAttachmentId String?
  hirerSignatureAttachment Attachment? @relation("CarOutHirerSignature", fields: [hirerSignatureAttachmentId], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())

  photos ContractCarOutPhoto[]

  @@map("contract_car_outs")
}

/// Staff-only operational preparation. It does not activate the rental.
model ContractCarOutDraft {
  id                         String @id @default(uuid())
  contractId                 String @unique
  contract                   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  mileageOut                 Int?
  fuelOut                    String?
  damageOut                  Json?
  notes                      String?
  hirerSignatureAttachmentId String?
  hirerSignatureAttachment   Attachment? @relation("CarOutDraftHirerSignature", fields: [hirerSignatureAttachmentId], references: [id], onDelete: Restrict)
  photos                     ContractCarOutDraftPhoto[]
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("contract_car_out_drafts")
}

model ContractCarOutDraftPhoto {
  id           String @id @default(uuid())
  carOutDraftId String
  carOutDraft  ContractCarOutDraft @relation(fields: [carOutDraftId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   Attachment @relation("CarOutDraftPhotoAttachment", fields: [attachmentId], references: [id], onDelete: Restrict)
  angle        ContractInspectionAngle
  createdAt    DateTime @default(now())

  @@unique([carOutDraftId, angle])
  @@unique([carOutDraftId, attachmentId])
  @@map("contract_car_out_draft_photos")
}

model ContractCarOutPhoto {
  id           String                  @id @default(uuid())
  carOutId     String
  carOut       ContractCarOut          @relation(fields: [carOutId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   Attachment              @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  angle        ContractInspectionAngle
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())

  @@unique([carOutId, angle])
  @@unique([carOutId, attachmentId])
  @@index([carOutId, sortOrder])
  @@map("contract_car_out_photos")
}

model ContractCarIn {
  id         String   @id @default(uuid())
  contractId String   @unique
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  occurredAt DateTime
  mileageIn  Int
  fuelIn     String
  notes      String?
  createdAt  DateTime @default(now())

  photos ContractCarInPhoto[]

  @@map("contract_car_ins")
}

model ContractCarInPhoto {
  id           String                  @id @default(uuid())
  carInId      String
  carIn        ContractCarIn           @relation(fields: [carInId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   Attachment              @relation("ContractCarInPhotoAttachment", fields: [attachmentId], references: [id], onDelete: Restrict)
  angle        ContractInspectionAngle
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())

  @@unique([carInId, angle])
  @@unique([carInId, attachmentId])
  @@index([carInId, sortOrder])
  @@map("contract_car_in_photos")
}

model ContractReconciliation {
  id               String           @id @default(uuid())
  contractId       String           @unique
  contract         Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  chargesTotal     Int
  /// Legacy columns — Diamond V1 reconciliation uses finalAmount = chargesTotal only.
  depositAmount    Int              @default(0)
  deductions       Int              @default(0)
  finalAmount      Int
  approvedAt       DateTime?
  approvedByUserId Int?
  approvedBy       User?            @relation("ContractReconciliationApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  settledAt        DateTime?
  settledPaymentId String?          @unique
  settledPayment   ContractPayment? @relation("ReconciliationSettlement", fields: [settledPaymentId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lines ContractReconciliationLine[]

  @@map("contract_reconciliations")
}

model ContractReconciliationLine {
  id                     String                         @id @default(uuid())
  reconciliationId       String
  reconciliation         ContractReconciliation         @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  type                   ContractReconciliationLineType
  description            String
  /// Final customer charge. For RoadLiability-backed lines this is customerChargeAmount, not the official RTA/Salik amount.
  amount                 Int
  /// Opaque reference into Salik/Violations/Finance — no engine lives here.
  externalReference      String?
  sourceDomain           String?
  /// Unique double-charge guard. One RoadLiability may back at most one line.
  roadLiabilityId        String?                        @unique
  roadLiability          RoadLiability?                 @relation(fields: [roadLiabilityId], references: [id], onDelete: Restrict)
  officialAmountSnapshot Int?
  adjustmentAmount       Int?
  adjustmentReason       String?
  adjustmentNote         String?
  confirmedByUserId      Int?
  confirmedBy            User?                          @relation("ContractReconciliationLineConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmedAt            DateTime?
  customerCharge         RoadLiabilityCustomerCharge?
  createdAt              DateTime                       @default(now())

  @@index([reconciliationId])
  @@map("contract_reconciliation_lines")
}

model ContractRenewal {
  id               String           @id @default(uuid())
  contractId       String
  contract         Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  additionalDays   Int
  additionalAmount Int
  previousEndAt    DateTime
  newEndAt         DateTime
  createdAt        DateTime         @default(now())
  /// Customer accepted the offer. Contract extension applies only after payment (or zero amount).
  approvedAt       DateTime?
  appliedAt        DateTime?
  settledPaymentId String?          @unique
  settledPayment   ContractPayment? @relation("RenewalSettlement", fields: [settledPaymentId], references: [id], onDelete: SetNull)
  createdByUserId  Int?
  createdBy        User?            @relation("ContractRenewalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
  @@map("contract_renewals")
}

model CustomerDocument {
  id           String               @id @default(uuid())
  customerId   Int
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type         CustomerDocumentType
  attachmentId String
  attachment   Attachment           @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  createdAt    DateTime             @default(now())

  @@unique([customerId, attachmentId])
  @@index([customerId, type])
  @@map("customer_documents")
}
