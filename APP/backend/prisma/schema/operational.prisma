// ---------------------------------------------------------------------------
// Operational domain (product): Customer -> Vehicle -> PurchaseExperience.
// The clean source of truth that BE-1C import will later populate. See
// docs/superpowers/specs/ for BE-1B design.
//
// Key modeling rules:
//   - Customer != a single sale. A customer has MANY PurchaseExperiences.
//   - Vehicle may recur across experiences (e.g. resale) — vehicleId is NOT unique.
//   - Required master-data FKs use the default Restrict action: operational
//     history is NEVER cascade-deleted. Deactivating master data is soft and
//     preserves these historical references.
//   - mobile/email are normalized + indexed for search but NOT unique (a number
//     or address may be shared); the only hard customer key is `externalId`.
// ---------------------------------------------------------------------------

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

// Fleet operational status for the Vehicles page (available / rented / service).
// Distinct from Vehicle.isActive (master-data lifecycle) and from contract status.
enum VehicleOperationalStatus {
  AVAILABLE
  RENTED
  SERVICE
}

model Customer {
  id             Int          @id @default(autoincrement())
  name           String
  // Normalized (digits/+) & lowercased respectively; indexed for search, NOT unique.
  mobile         String?
  email          String?
  type           CustomerType @default(INDIVIDUAL)
  // Per-channel communication opt-out foundation (WhatsApp is its own channel).
  optOutEmail    Boolean      @default(false)
  optOutSms      Boolean      @default(false)
  optOutPhone    Boolean      @default(false)
  optOutWhatsApp Boolean      @default(false)
  // ERP/CRM identity — the only hard unique business key for a customer.
  externalId     String?      @unique
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Rental-flow identity (nullable so existing CRM customers stay valid).
  nationality          String?
  identityNumber       String?
  passportNumber       String?
  drivingLicenseNumber String?
  drivingLicenseExpiry DateTime?
  address              String?
  /// One Stripe Customer per Diamond customer for the current Stripe account (UNIQUE/ELITE share one account).
  stripeCustomerId     String?   @unique

  experiences           PurchaseExperience[]
  callQueueItems        CallCenterQueueItem[]
  complaints            Complaint[]
  contracts             Contract[]
  documents             CustomerDocument[]
  whatsAppConversations WhatsAppConversation[]
  paymentProfiles       CustomerPaymentProfile[]
  paymentAuthorizations ContractPaymentAuthorization[]

  @@index([mobile])
  @@index([email])
  @@index([identityNumber])
  @@index([passportNumber])
  @@index([drivingLicenseNumber])
  @@index([isActive])
  @@map("customers")
}

model Vehicle {
  id                Int                      @id @default(autoincrement())
  /// Owning Diamond company. Required: every fleet vehicle, active or retired,
  /// belongs to exactly one company. Changing it re-assigns the vehicle from now
  /// on; it never rewrites the company of Contracts already created (see
  /// Contract.companyId).
  companyId         Int
  company           OperatingCompany         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Strongest vehicle identifier where available. Stored normalized (UPPER+trim);
  // unique when present (nullable => many null VINs allowed).
  vin               String?                  @unique
  // Free-text fleet name (Diamond Add Vehicle). When set, this is the primary
  // display label; legacy/import rows may rely on `model` instead.
  vehicleName       String?
  // Optional catalog link — legacy/import vehicles may reference VehicleModel;
  // new Diamond fleet vehicles are created with vehicleName only.
  modelId           Int?
  model             VehicleModel?            @relation(fields: [modelId], references: [id], onDelete: Restrict)
  modelYear         Int?
  // CX display context only (not a colour taxonomy). Free-text from ERP/import;
  // trimmed, nullable. Belongs to the vehicle itself, not the sale.
  color             String?
  // Registration plate for fleet display. Stored normalized (trim + collapsed spaces + UPPER).
  plateNumber       String?                  @unique
  // Default rental rates in whole AED (Diamond demo). Not the rental-offer final amount.
  dailyRate         Int?
  monthlyRate       Int?
  operationalStatus VehicleOperationalStatus @default(AVAILABLE)
  /// Integration id from the owning company's external system. Unique WITHIN a
  /// company: UNIQUE and ELITE may legitimately reuse the same id in their own
  /// namespaces. Lookups must always pass companyId + externalId.
  externalId        String?
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  experiences               PurchaseExperience[]
  photos                    VehiclePhoto[]
  contracts                 Contract[]
  maintenanceOrders         MaintenanceOrder[]
  manualExpenses            ManualExpense[]
  gpsBinding                VehicleGpsBinding?
  gpsLatestState            VehicleGpsLatestState?
  roadLiabilities           RoadLiability[]
  roadLiabilityObservations RoadLiabilityObservation[]
  tarsIntegrations          TarsVehicleIntegration[]

  @@unique([companyId, externalId])
  @@index([companyId])
  @@index([modelId])
  @@index([isActive])
  @@index([operationalStatus])
  @@map("vehicles")
}

/// Vehicle gallery image linked to the shared Attachment store.
model VehiclePhoto {
  id           String     @id @default(uuid())
  vehicleId    Int
  vehicle      Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  sortOrder    Int        @default(0)
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([vehicleId, attachmentId])
  @@index([vehicleId, sortOrder])
  @@map("vehicle_photos")
}

// The actual customer experience event (purchase + delivery). Customer and
// Vehicle are immutable after creation.
model PurchaseExperience {
  id             Int          @id @default(autoincrement())
  customerId     Int
  customer       Customer     @relation(fields: [customerId], references: [id])
  // A vehicle may back more than one experience — NOT unique.
  vehicleId      Int
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  branchId       Int
  branch         Branch       @relation(fields: [branchId], references: [id])
  salespersonId  Int?
  salesperson    Salesperson? @relation(fields: [salespersonId], references: [id])
  purchaseDate   DateTime?
  deliveryDate   DateTime?
  // External sale/order identifier — unique when present.
  externalSaleId String?      @unique
  // CX context for the sale (NOT a finance/insurance management domain). Simple
  // optional free-text from ERP/import — a label, never a policy/contract entity.
  financingType  String?
  insuranceType  String?
  salesChannel   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  callQueueItems CallCenterQueueItem[]
  complaints     Complaint[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([branchId])
  @@index([salespersonId])
  @@index([purchaseDate])
  @@index([deliveryDate])
  @@map("purchase_experiences")
}

enum PaymentProviderKind {
  STRIPE
}

enum CustomerPaymentMethodStatus {
  ACTIVE
  REVOKED
}

/// One Stripe Customer per Diamond Customer, account, and livemode.
model CustomerPaymentProfile {
  id                 String                  @id @default(uuid())
  customerId         Int
  customer           Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider           PaymentProviderKind     @default(STRIPE)
  /// Deterministic Stripe account discriminator (never a secret).
  providerAccountKey String
  livemode           Boolean
  providerCustomerId String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  paymentMethods     CustomerPaymentMethod[]

  @@unique([customerId, provider, providerAccountKey, livemode])
  @@unique([provider, providerAccountKey, livemode, providerCustomerId])
  @@index([providerCustomerId])
  @@map("customer_payment_profiles")
}

/// Customer-owned saved card reference (Stripe vault id + safe metadata only).
model CustomerPaymentMethod {
  id                      String                         @id @default(uuid())
  profileId               String
  profile                 CustomerPaymentProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  providerPaymentMethodId String
  type                    String                         @default("CARD")
  cardBrand               String
  cardLast4               String
  expMonth                Int?
  expYear                 Int?
  status                  CustomerPaymentMethodStatus    @default(ACTIVE)
  lastUsedAt              DateTime?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  authorizations          ContractPaymentAuthorization[]
  offSessionAttempts      ContractPaymentOffSessionAttempt[]

  @@unique([profileId, providerPaymentMethodId])
  @@map("customer_payment_methods")
}
