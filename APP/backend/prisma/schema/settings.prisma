// ---------------------------------------------------------------------------
// Generic settings store. Typed access via getSetting/getNumberSetting/...
// Secrets should prefer env; `isSecret` values are never returned by public
// settings endpoints. `isPublic` marks safe-to-expose settings/capabilities.
// ---------------------------------------------------------------------------

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model Setting {
  id          Int         @id @default(autoincrement())
  key         String      @unique
  // Serialized value; interpreted according to `type` by typed accessors.
  value       String
  type        SettingType @default(STRING)
  scope       String?
  isSecret    Boolean     @default(false)
  isPublic    Boolean     @default(false)
  description String?
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())

  @@index([scope])
  @@map("settings")
}
