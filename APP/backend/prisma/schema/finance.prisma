// ---------------------------------------------------------------------------
// Finance V1 — immutable ledger read model + manual company expenses.
// Obligations stay in Contract/Renewal/Reconciliation/PostClose domains.
// Customer collections stay in ContractPayment (trusted Stripe CARD + explicit CASH).
// ---------------------------------------------------------------------------

enum FinancialLedgerKind {
  RENTAL_PAYMENT
  RENEWAL_PAYMENT
  RECONCILIATION_PAYMENT
  POST_CLOSE_RECEIVABLE_PAYMENT
  ROAD_LIABILITY_PAYMENT
  MAINTENANCE_EXPENSE
  MANUAL_EXPENSE
  MANUAL_EXPENSE_REVERSAL
}

enum FinancialLedgerSourceType {
  CONTRACT_PAYMENT
  MAINTENANCE_ORDER
  MANUAL_EXPENSE
}

enum ManualExpenseCategory {
  VEHICLE_CLEANING
  FUEL
  PARKING
  GOVERNMENT_FEES
  OFFICE_ADMIN
  MARKETING
  OPERATIONS
  OTHER
}

enum ManualExpenseStatus {
  ACTIVE
  VOID
}

model FinancialLedgerEntry {
  id                 String                    @id @default(uuid())
  kind               FinancialLedgerKind
  sourceType         FinancialLedgerSourceType
  sourceId           String
  dedupeKey          String                    @unique
  amount             Int
  currency           String                    @default("AED")
  occurredAt         DateTime
  contractId         String?
  customerId         Int?
  vehicleId          Int?
  contractPaymentId  String?
  maintenanceOrderId Int?
  manualExpenseId    String?
  /// Company classification PERSISTED AT WRITE TIME from the entry's authoritative
  /// source (Contract.company, Vehicle.company, ManualExpense.company). A recognized
  /// movement is history and must never be re-derived later.
  ///
  /// Nullable on purpose: a vehicle-less Manual Expense (office rent, marketing) is
  /// GENERAL — it belongs to no operating company. GENERAL is `null`, never a third
  /// OperatingCompany row and never a silent UNIQUE fallback.
  companyId          Int?
  createdAt          DateTime                  @default(now())

  contractPayment  ContractPayment?  @relation(fields: [contractPaymentId], references: [id], onDelete: Restrict)
  maintenanceOrder MaintenanceOrder? @relation(fields: [maintenanceOrderId], references: [id], onDelete: Restrict)
  manualExpense    ManualExpense?    @relation(fields: [manualExpenseId], references: [id], onDelete: Restrict)
  company          OperatingCompany? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([kind])
  @@index([sourceType])
  @@index([contractId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([manualExpenseId])
  /// Company-scoped Finance aggregates always filter company + period together,
  /// and the leading column also serves a plain `companyId` lookup.
  @@index([companyId, occurredAt])
  @@map("financial_ledger_entries")
}

model ManualExpense {
  id                    String                @id @default(uuid())
  amount                Int
  currency              String                @default("AED")
  category              ManualExpenseCategory
  recognizedAt          DateTime
  description           String
  vehicleId             Int?
  vehicle               Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  /// BACKEND-OWNED classification, never a client input and never a form field.
  /// Derived from the optional Vehicle: a Vehicle makes the expense that Vehicle's
  /// company (`Vehicle.companyId` is write-once, so it is permanently correct);
  /// no Vehicle means GENERAL and stays `null`. There is no company selector.
  companyId             Int?
  company               OperatingCompany?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vendorName            String?
  receiptNumber         String?
  attachmentId          String?
  attachment            Attachment?           @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  note                  String?
  status                ManualExpenseStatus   @default(ACTIVE)
  correctionOfExpenseId String?
  correctionOfExpense   ManualExpense?        @relation("ManualExpenseCorrection", fields: [correctionOfExpenseId], references: [id], onDelete: SetNull)
  corrections           ManualExpense[]       @relation("ManualExpenseCorrection")
  voidedAt              DateTime?
  voidedByUserId        Int?
  voidedBy              User?                 @relation("ManualExpenseVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  voidReason            String?
  createdByUserId       Int
  createdBy             User                  @relation("ManualExpenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt             DateTime              @default(now())

  ledgerEntries FinancialLedgerEntry[]
  revisions     ManualExpenseRevision[]

  @@index([recognizedAt])
  @@index([status])
  @@index([category])
  @@index([vehicleId])
  @@index([createdByUserId])
  @@index([companyId])
  @@map("manual_expenses")
}

/// Immutable in-place correction history. Never used for VOID.
model ManualExpenseRevision {
  id              String        @id @default(uuid())
  manualExpenseId String
  manualExpense   ManualExpense @relation(fields: [manualExpenseId], references: [id], onDelete: Cascade)
  changedByUserId Int
  changedBy       User          @relation("ManualExpenseRevisionChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)
  changedAt       DateTime      @default(now())
  /// Only fields that actually changed: `{ field: { before, after } }`.
  changes         Json

  @@index([manualExpenseId, changedAt])
  @@index([changedByUserId])
  @@map("manual_expense_revisions")
}
