// ---------------------------------------------------------------------------
// TARS integration state — technical metadata only. Diamond Contract, Customer,
// Vehicle, Payment and Attachments remain authoritative. Official RTA/TARS
// capabilities are modelled here; legacy operation types are preserved for
// migration-safe history. See DOCU/04-api-contracts/tars-integration.md.
// ---------------------------------------------------------------------------

/// Official rental lifecycle capabilities (RTA/TARS documentation).
enum TarsOperationType {
  CREATE_RENTAL
  UPDATE_RENTAL
  RETURN_RENTAL
  SETTLE_RENTAL
  /// Legacy rows only — do not use for new writes.
  REGISTER_CONTRACT
  CONTRACT_ACCEPTANCE
  HANDOVER
  RETURN_DOCUMENTATION
  COMPLETE_CONTRACT
}

/// Async operation lifecycle. PENDING/PROCESSING are legacy values kept for
/// historical rows; new writes use SUBMITTING and PENDING_PROVIDER.
enum TarsOperationStatus {
  PENDING
  PROCESSING
  SUBMITTING
  PENDING_PROVIDER
  SUCCEEDED
  FAILED
}

enum TarsVehicleSyncStatus {
  NOT_STARTED
  SUBMITTING
  PENDING_PROVIDER
  SYNCED
  FAILED
}

enum TarsOtpVerificationStatus {
  REQUESTED
  VERIFIED
  EXPIRED
  FAILED
}

/// One integration record per Diamond Contract.
model TarsContractIntegration {
  id                   String    @id @default(uuid())
  contractId           String    @unique
  contract             Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// Legacy external contract reference from pre-official integration rows.
  externalContractId   String?
  /// Authoritative TARS Rental DID once CREATE_RENTAL succeeds.
  externalRentalDid    String?
  lastSuccessfulSyncAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  operations TarsOperation[]

  @@index([externalContractId])
  @@index([externalRentalDid])
  @@map("tars_contract_integrations")
}

/// Auditable attempt history. Repeatable types (UPDATE_RENTAL) distinguish
/// separate business events via `correlationSubject` (renewal id, revision, …).
/// HTTP 202 acceptance stores `providerRequestId` while status stays
/// PENDING_PROVIDER — 202 is never SUCCEEDED.
model TarsOperation {
  id                  String                  @id @default(uuid())
  integrationId       String
  integration         TarsContractIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  contractId          String
  contract            Contract                @relation(fields: [contractId], references: [id], onDelete: Cascade)
  operationType       TarsOperationType
  status              TarsOperationStatus     @default(SUBMITTING)
  /// Distinguishes repeatable operations (e.g. renewalId for UPDATE_RENTAL).
  correlationSubject  String?
  idempotencyKey      String?
  requestFingerprint  String?
  attemptNumber       Int                     @default(1)
  /// Provider async request id returned on HTTP 202 Accepted.
  providerRequestId   String?
  externalReference   String?
  providerOperationId String?
  lastErrorCode       String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([contractId, operationType, createdAt])
  @@index([contractId, operationType, correlationSubject])
  @@index([integrationId, status])
  @@index([providerRequestId])
  @@map("tars_operations")
}

/// TARS Vehicle DID scoped to the owning operating company.
model TarsVehicleIntegration {
  id                   String                @id @default(uuid())
  vehicleId            Int
  vehicle              Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyId            Int
  company              OperatingCompany      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  externalVehicleDid   String?
  syncStatus           TarsVehicleSyncStatus @default(NOT_STARTED)
  lastSuccessfulSyncAt DateTime?
  lastErrorCode        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([vehicleId, companyId])
  @@index([companyId, externalVehicleDid])
  @@map("tars_vehicle_integrations")
}

/// Diamond Attachment → TARS upload mapping per company. Stores returned
/// hash/url only — never Attachment bytes.
model TarsAttachmentUpload {
  id            String           @id @default(uuid())
  attachmentId  String
  attachment    Attachment       @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  companyId     Int
  company       OperatingCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  externalUrl   String?
  externalHash  String?
  uploadedAt    DateTime?
  lastErrorCode String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([attachmentId, companyId])
  @@index([companyId])
  @@map("tars_attachment_uploads")
}

/// TARS OTP challenge state. OTP values are NEVER stored.
model TarsContractOtpChallenge {
  id                 String                    @id @default(uuid())
  contractId         String
  contract           Contract                  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  provider           String
  challengeReference String?
  maskedDestination  String?
  status             TarsOtpVerificationStatus @default(REQUESTED)
  requestedAt        DateTime                  @default(now())
  expiresAt          DateTime?
  resendAvailableAt  DateTime?
  otpLength          Int?
  maxAttempts        Int?
  verifiedAt         DateTime?
  attemptCount       Int                       @default(0)
  lastErrorCode      String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([contractId, createdAt])
  @@index([contractId, status])
  @@map("tars_contract_otp_challenges")
}
