{
  "name": "haidara",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Haidara backend — Fastify 5 + TypeScript + Prisma 7 + PostgreSQL. Auth, RBAC, audit, notifications, files, settings, complaints, reports.",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && node scripts/copy-assets.cjs",
    "start": "node dist/src/server.js",
    "simulate:notifications": "tsx scripts/simulate-notifications.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier -c .",
    "format:write": "prettier -w .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma generate && prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test-concurrency=1 --test tests/integration/*.test.ts",
    "verify:reports": "tsx scripts/verify-reports.ts",
    "verify:finance-company": "tsx scripts/verify-finance-company.ts",
    "db:seed:demo": "tsx prisma/seed/demo-fleet.ts",
    "db:cleanup:dev-fleet": "tsx scripts/cleanup-dev-fleet.ts",
    "db:cleanup:dev-users": "tsx scripts/cleanup-dev-users.ts",
    "db:cleanup:dev-users:only-admin": "tsx scripts/cleanup-dev-users.ts --only-admin",
    "db:cleanup:dev-roles": "tsx scripts/cleanup-dev-roles.ts",
    "db:cleanup:dev-roles:only-system-admin": "tsx scripts/cleanup-dev-roles.ts --only-system-admin",
    "dev:bootstrap": "tsx scripts/dev-bootstrap.ts",
    "dev:check": "tsx scripts/dev-check.ts",
    "test:pushover": "tsx scripts/test-pushover.ts"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "keywords": [
    "fastify",
    "prisma",
    "typescript",
    "rbac",
    "openapi",
    "haidara"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/compress": "^8.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "bidi-js": "^1.0.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "i18next": "^25.6.0",
    "jszip": "^3.10.1",
    "nodemailer": "^9.0.3",
    "otpauth": "^9.5.1",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "sanitize-html": "^2.17.6",
    "stripe": "^18.5.0",
    "zod": "^4.3.5",
    "zod-prisma-types": "^3.3.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.38.0",
    "pino-pretty": "^13.1.2",
    "pm2": "^7.0.3",
    "prettier": "3.8.0",
    "prisma": "^7.2.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
