NEXT_PUBLIC_API_URL=http://localhost:8000

# Functional RBAC V2 (Phase 3 — default off; enable only in isolated staging)
# NEXT_PUBLIC_FUNCTIONAL_RBAC_V2_UI=true
# NEXT_PUBLIC_FUNCTIONAL_RBAC_V2_BACKEND_ENABLED=true

# GPS map satellite base layer (optional overrides; empty URL disables satellite toggle)
# NEXT_PUBLIC_GPS_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# NEXT_PUBLIC_GPS_SATELLITE_ATTRIBUTION=Esri, Maxar, Earthstar Geographics, and the GIS User Community
# TEMP-DEV-SIMULATION: remove to hide simulate buttons (license, passport OCR, payment).
NEXT_PUBLIC_DIAMOND_SIMULATION=true
NEXT_PUBLIC_DEMO_SIMULATION_ENABLED=true
AUTH_URL=http://localhost:3100
# Required by Auth.js in production. Generate a unique value; never commit it.
AUTH_SECRET=replace-with-strong-random-auth-secret-min-32-chars
# Set true when the browser reaches Next through a reverse proxy.
# AUTH_TRUST_HOST=true
