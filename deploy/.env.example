# Compose interpolation only. Copy to deploy/.env.
# Do not put the operational database password here.
POSTGRES_PASSWORD=replace-with-staging-db-password
AUTH_SECRET=replace-with-strong-random-auth-secret-min-32-chars
# Baked into the frontend image. Same-host staging uses loopback.
# A reverse proxy must set the public origin and rebuild the frontend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
