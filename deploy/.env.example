# Compose interpolation only. Copy to deploy/.env.
# Do not put the operational database password here.
POSTGRES_PASSWORD=replace-with-staging-db-password
AUTH_SECRET=replace-with-strong-random-auth-secret-min-32-chars
# Browser-visible origin (CORS, NextAuth AUTH_URL, backend FRONTEND_URL).
# Loopback: http://127.0.0.1:3100
# GitHub Codespaces: https://${CODESPACE_NAME}-3100.app.github.dev
STAGING_PUBLIC_ORIGIN=http://127.0.0.1:3100
# Baked into the frontend image. Loopback: http://127.0.0.1:3000
# Codespaces same-origin proxy: http://backend:3000 with NEXT_PUBLIC_API_PROXY=true
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_PROXY=false
# Initial isolated bring-up: disable in-process scheduler (override in staging.env too).
SCHEDULER_ENABLED=false
