# Copy to deploy/staging.env and replace every value.
# staging.env is gitignored. Do not point DATABASE_URL at haidara.
NODE_ENV=production
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-strong-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-strong-random-refresh-secret-min-32-chars
COOKIE_SECRET=replace-with-strong-random-cookie-secret-min-32-chars
TWO_FACTOR_ENCRYPTION_KEY=replace-with-strong-random-two-factor-key-min-32-chars
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:3100
FRONTEND_URL=http://127.0.0.1:3100
SCHEDULER_ENABLED=true
FILE_STORAGE_DIR=/app/uploads
BUSINESS_TIMEZONE_OFFSET_MINUTES=240
PAYMENT_PROVIDER=none
GPS_ENABLED=false
TARS_ENABLED=false
EMAIL_ENABLED=false
SEED_DEV_ADMIN=false
