{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UAE licence OCR ground truth (human-verified)",
  "type": "object",
  "required": ["test_id", "fields", "verified_by", "verified_at"],
  "properties": {
    "test_id": { "type": "string" },
    "source_input_sha256": { "type": "string", "description": "From Crop V1 run_metadata / ocr_handoff" },
    "verified_by": { "type": "string" },
    "verified_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" },
    "fields": {
      "type": "object",
      "properties": {
        "license_number": { "type": "string" },
        "name_ar": { "type": "string" },
        "name_en": { "type": "string" },
        "nationality": { "type": "string" },
        "date_of_birth": { "type": "string", "pattern": "^\\d{2}/\\d{2}/\\d{4}$" },
        "issue_date": { "type": "string", "pattern": "^\\d{2}/\\d{2}/\\d{4}$" },
        "expiry_date": { "type": "string", "pattern": "^\\d{2}/\\d{2}/\\d{4}$" },
        "place_of_issue": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
